{
  "mcpServers": {
    "agb": {
      "command": "node",
      "args": ["${PLUGIN_ROOT}/dist/mcp-server.mjs"],
      "timeoutSeconds": -1,
      "tools": {
        "agb_run": {
          "background": "always"
        },
        "agb_status": {
          "eager": true
        },
        "agb_doctor": {
          "eager": true
        }
      }
    }
  }
}
