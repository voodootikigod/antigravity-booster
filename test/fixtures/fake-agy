#!/bin/sh
# Fake agy for offline tests. Reads the prompt from stdin and decides
# behavior from prompt content (role markers) + env knobs. Mirrors real agy
# quirks: prompt on stdin, exit 0 even on timeout.

# Plugin subcommands are argv-based (no stdin payload) — handle them before
# the unconditional `cat` below, which would otherwise block callers that
# invoke this fixture with stdio:'inherit' and no stdin to pipe.
if [ "$1" = "plugin" ]; then
  case "$2" in
    install)
      case "${FAKE_AGY_PLUGIN_MODE:-ok}" in
        fail) echo "boom: simulated plugin install failure" >&2; exit 1 ;;
        *)
          if [ -n "$FAKE_STATE_DIR" ]; then
            echo "$3" >> "$FAKE_STATE_DIR/plugin-installs"
          fi
          echo "installed plugin from $3"
          exit 0 ;;
      esac ;;
  esac
fi

prompt=""
output_format=""
json_schema=""
for i in $(seq 1 $#); do
  eval arg=\$$i
  if [ "$arg" = "--print" ]; then
    next=$((i+1))
    eval prompt=\$$next
  fi
  if [ "$arg" = "--output-format" ]; then
    next=$((i+1))
    eval output_format=\$$next
  fi
  if [ "$arg" = "--json-schema" ]; then
    next=$((i+1))
    eval json_schema=\$$next
  fi
done
if [ -z "$prompt" ] && [ "$1" != "--version" ] && [ "$1" != "models" ] && [ "$1" != "plugin" ]; then
  prompt=$(cat)
fi

is_expected=""
case "$prompt" in
  *"TICKET-DONE or TICKET-BLOCKED"*)
    if echo "$prompt" | grep -q "Fix every finding"; then
      is_expected="fix"
    else
      is_expected="build"
    fi
    ;;
  *"You are a prosecutor"*)
    if echo "$prompt" | grep -q "exactly one lens"; then
      is_expected="review"
    else
      is_expected="prosecute"
    fi
    ;;
esac

if [ -n "$is_expected" ]; then
  has_project=0
  for arg in "$@"; do
    if [ "$arg" = "--project" ]; then
      has_project=1
    fi
  done
  if [ "$has_project" -eq 0 ]; then
    echo "Error: --project flag missing for $is_expected path" >&2
    exit 33
  fi
fi

# Reveal the env this invocation actually received (scheduler tests verify
# ADLC_P4_ENFORCEMENT/ADLC_TICKET were passed to THIS spawn, not leaked
# globally). Every non-plugin invocation gets a line, harmless when the vars
# are unset (prosecutor/reader calls never set them).
if [ -n "$FAKE_STATE_DIR" ]; then
  printf 'ADLC_P4_ENFORCEMENT=%s ADLC_TICKET=%s\n' "${ADLC_P4_ENFORCEMENT:-}" "${ADLC_TICKET:-}" >> "$FAKE_STATE_DIR/agy-env-seen"
  printf '%s\n' "$*" >> "$FAKE_STATE_DIR/agy-argv-seen"
fi

# Global failure injection (any role): simulate a model/transport error.
case "${FAKE_AGY_MODE:-}" in
  fail) echo "boom: simulated agy failure" >&2; exit 1 ;;
  timeout) echo "Error: timed out waiting for response"; exit 0 ;;
  empty) exit 0 ;;
  server) echo "simulated server-side error" >&2; exit 1 ;;
esac

if [ "$1" = "--version" ]; then
  echo "agy version 1.2.3"
  exit 0
fi

if [ "$1" = "models" ]; then
  echo "gemini-flash"
  echo "claude"
  exit 0
fi

case "$prompt" in
  *FAKE:TIMEOUT*) echo "Error: timed out waiting for response"; exit 0 ;;
esac

# Brain-plan conversion role. FAKE_BRAIN_MODE:
#   good (default)      — one valid ticket
#   edges               — two valid tickets joined by an edge (parallax fodder)
#   invalid-then-good   — first call structurally broken (empty body + scope
#                         overlap), later calls valid ONLY if the prompt
#                         carries compiler feedback (needs FAKE_STATE_DIR)
case "$prompt" in
  *"Convert this Antigravity implementation plan"*)
    mode="${FAKE_BRAIN_MODE:-good}"
    if [ "$mode" = "invalid-then-good" ] && [ -n "$FAKE_STATE_DIR" ]; then
      cf="$FAKE_STATE_DIR/conversions"
      n=$(cat "$cf" 2>/dev/null || echo 0)
      echo $((n + 1)) > "$cf"
      if [ "$n" -eq 0 ]; then
        echo '{"repo": "/r", "base": "main", "gate": {"test": "true"}, "tickets": [{"id": "T1", "title": "a", "body": "", "scope": ["src/x.mjs"], "edges": []}, {"id": "T2", "title": "b", "body": "do b fully specified", "scope": ["src/x.mjs"], "edges": []}]}'
        exit 0
      fi
      # The retry must carry the compiler feedback block; without it stay broken.
      case "$prompt" in
        *"Compiler feedback"*) mode=good ;;
        *) echo '{"repo": "/r", "tickets": []}'; exit 0 ;;
      esac
    fi
    if [ "$mode" = "edges" ]; then
      echo '{"repo": "/r", "base": "main", "gate": {"test": "true"}, "tickets": [{"id": "T1", "title": "widget step 1", "body": "do step 1 fully specified", "scope": ["src/widget/**"], "edges": [{"to": "T2"}], "tier": "mid", "pool_hint": "auto"}, {"id": "T2", "title": "widget step 2", "body": "do step 2 fully specified", "scope": ["src/widget2/**"], "edges": [], "tier": "mid", "pool_hint": "auto"}]}'
    else
      echo '{"repo": "/r", "base": "main", "gate": {"test": "true"}, "tickets": [{"id": "T1", "title": "widget step 1", "body": "do step 1 fully specified", "scope": ["src/widget/**"], "edges": [], "tier": "mid", "pool_hint": "auto"}]}'
    fi
    exit 0 ;;
esac

# Coldstart plan gate. FAKE_COLDSTART_MODE: clean (default) | gap |
# gap-once (first call gaps, later calls clean; needs FAKE_STATE_DIR) |
# garbage (unparseable output).
case "$prompt" in
  *"cold-start check"*)
    case "${FAKE_COLDSTART_MODE:-clean}" in
      gap) echo '{"gaps": ["acceptance criteria undefined"]}' ;;
      gap-once)
        cf="$FAKE_STATE_DIR/coldstarts"
        n=$(cat "$cf" 2>/dev/null || echo 0)
        echo $((n + 1)) > "$cf"
        if [ "$n" -eq 0 ]; then echo '{"gaps": ["acceptance criteria undefined"]}'; else echo '{"gaps": []}'; fi ;;
      garbage) echo "OK" ;;
      *) echo '{"gaps": []}' ;;
    esac
    exit 0 ;;
esac

# Parallax reader role (per-edge contract authoring).
case "$prompt" in
  *"Author the contract"*)
    echo '{"contract": "lib/widget.mjs exports buildWidget(spec) returning a Widget"}'
    exit 0 ;;
esac

# Parallax judge role. FAKE_PARALLAX_VERDICT: converged (default) | divergent.
case "$prompt" in
  *"independent readings"*)
    if [ "${FAKE_PARALLAX_VERDICT:-converged}" = "divergent" ]; then
      echo '{"divergent": true, "divergences": ["export name disagrees: buildWidget vs makeWidget"]}'
    else
      echo '{"divergent": false, "divergences": []}'
    fi
    exit 0 ;;
esac

# Premortem role. FAKE_PREMORTEM_MODE: causes (default) | garbage.
case "$prompt" in
  *"Write the postmortem"*)
    if [ "${FAKE_PREMORTEM_MODE:-causes}" = "garbage" ]; then
      echo "no json here"
    else
      echo '{"causes": [{"cause": "T1 body omits the widget schema, builders will invent one", "likelihood": "high", "mitigation": "name the schema file in the plan"}]}'
    fi
    exit 0 ;;
esac

# Prosecutor role (prompt carries the refute charter).
case "$prompt" in
  *"You are a prosecutor"*)
    verdict="${FAKE_PROSECUTOR_VERDICT:-ship}"
    if [ -n "$FAKE_STATE_DIR" ]; then
      # block-then-ship: first call blocks, later calls ship.
      count_file="$FAKE_STATE_DIR/prosecutions"
      n=$(cat "$count_file" 2>/dev/null || echo 0)
      echo $((n + 1)) > "$count_file"
      if [ "$n" -eq 0 ] && [ "$verdict" = "block-then-ship" ]; then verdict=block; else
        [ "$verdict" = "block-then-ship" ] && verdict=ship
      fi
    fi
    # ship-with-high / ship-with-low decouple the two signals the real gate
    # reads: the model's stated verdict, and the severity of its findings. The
    # block/ship modes move them together, so they cannot tell which one decides.
    case "$verdict" in
      block)
        echo '{"findings": [{"severity": "high", "charge": "correctness", "file": "out.txt", "claim": "wrong content", "evidence": "diff"}], "verdict": "block"}' ;;
      block-empty)
        echo '{"findings": [], "verdict": "block"}' ;;
      ship-with-high)
        echo '{"findings": [{"severity": "high", "charge": "correctness", "file": "out.txt", "claim": "wrong content", "evidence": "diff"}], "verdict": "ship"}' ;;
      ship-with-critical)
        echo '{"findings": [{"severity": "critical", "charge": "security", "file": "out.txt", "claim": "rce", "evidence": "diff"}], "verdict": "ship"}' ;;
      ship-with-low)
        echo '{"findings": [{"severity": "low", "charge": "style", "file": "out.txt", "claim": "nit", "evidence": "diff"}], "verdict": "ship"}' ;;
      *)
        echo '{"findings": [], "verdict": "ship"}' ;;
    esac
    exit 0 ;;
esac

# Builder role (prompt names the ticket protocol).
case "$prompt" in
  *"TICKET-DONE or TICKET-BLOCKED"*)
    mode="${FAKE_BUILDER_MODE:-good}"
    tid=$(echo "$prompt" | sed -n 's/.*[Tt]icket \([A-Za-z0-9_-]*\).*/\1/p' | head -1)
    case "$mode" in
      missing-result)
        echo '{"type":"step_update","step":1,"action":"working"}'
        exit 0 ;;
      server-shutdown)
        echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        exit 1 ;;
      duplicate-result)
        echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        exit 0 ;;
      overflow-line)
        node -e "process.stdout.write('x'.repeat(1024*1024 + 100) + '\n')"
        exit 0 ;;
      overflow-total)
        node -e "for(let i=0;i<51;i++) process.stdout.write('x'.repeat(1024*1024) + '\n')"
        exit 0 ;;
      corruption)
        node -e "for(let i=0;i<12;i++) process.stdout.write('g'.repeat(500*1024) + '\n')"
        exit 0 ;;
      heartbeat)
        echo '{"type":"step_update","step":1,"action":"start"}'
        echo '{"type":"heartbeat","timestamp":123456789}'
        echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        exit 0 ;;
      blocked)
        if [ "$output_format" = "stream-json" ]; then
          echo '{"type":"step_update","step":1,"action":"blocked"}'
          echo '{"type":"result","status":"ERROR","exit_code":1}'
        else
          echo "TICKET-BLOCKED: cannot proceed"
        fi
        exit 0 ;;
      bad)
        echo "wrong stuff" > "${tid:-out}.txt"
        if [ "$output_format" = "stream-json" ]; then
          echo '{"type":"step_update","step":1,"action":"bad"}'
          echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        else
          echo "TICKET-DONE"
        fi
        exit 0 ;;
      noop)
        if [ "$output_format" = "stream-json" ]; then
          echo '{"type":"step_update","step":1,"action":"noop"}'
          echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        else
          echo "TICKET-DONE"
        fi
        exit 0 ;;
      sabotage-math)
        mkdir -p src test
        echo "export function add(a, b) { return 42; }" > src/math.js
        cat << 'EOF' > test/math.test.js
import assert from 'node:assert';
import { add } from '../src/math.js';
assert.equal(add(1, 1), 42);
EOF
        if [ "$output_format" = "stream-json" ]; then
          echo '{"type":"step_update","step":1,"action":"sabotage-math"}'
          echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        else
          echo "TICKET-DONE"
        fi
        exit 0 ;;
      conflict)
        if [ "$tid" = "T0" ]; then
          echo "conflict t0 line" > shared.txt
        else
          sleep 0.2
          echo "conflict t1 line" > shared.txt
        fi
        if [ "$output_format" = "stream-json" ]; then
          echo '{"type":"step_update","step":1,"action":"conflict"}'
          echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        else
          echo "TICKET-DONE"
        fi
        exit 0 ;;
      # sabotage: in-scope marker that passes the worktree gate but makes a
      # `.git`-directory-aware post-merge gate fail on main (revert-path test).
      sabotage)
        echo "did the work" > "${tid:-out}.txt"
        echo sabotage > SABOTAGE
        if [ "$output_format" = "stream-json" ]; then
          echo '{"type":"step_update","step":1,"action":"sabotage"}'
          echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        else
          echo "TICKET-DONE"
        fi
        exit 0 ;;
      # rail: edits a read-only rail file that sits INSIDE the declared scope.
      rail)
        echo "did the work" > "${tid:-out}.txt"
        echo edited > RAIL.txt
        if [ "$output_format" = "stream-json" ]; then
          echo '{"type":"step_update","step":1,"action":"rail"}'
          echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        else
          echo "TICKET-DONE"
        fi
        exit 0 ;;
      # echo-adlc: snapshots cwd's ADLC ticket store (legacy tickets.json OR
      # the .adlc/tickets/ directory store, normalized to the {tickets:[...]}
      # envelope) to FAKE_STATE_DIR so a test can verify the scheduler
      # materialized it into the worktree BEFORE the build ran (the worktree
      # itself is deleted post-merge).
      echo-adlc)
        if [ -f .adlc/tickets.json ]; then
          cp .adlc/tickets.json "$FAKE_STATE_DIR/adlc-tickets-seen.json"
        elif [ -f .adlc/tickets/.store.json ]; then
          node -e "
            const fs=require('fs'),path=require('path'),p='.adlc/tickets';
            const tickets=fs.readdirSync(p).filter(f=>f!=='.store.json'&&f.endsWith('.json')).map(f=>JSON.parse(fs.readFileSync(path.join(p,f),'utf8')));
            fs.writeFileSync(path.join(process.env.FAKE_STATE_DIR,'adlc-tickets-seen.json'),JSON.stringify({tickets},null,2))"
        fi
        echo "did the work" > "${tid:-out}.txt"
        if [ "$output_format" = "stream-json" ]; then
          echo '{"type":"step_update","step":1,"action":"echo-adlc"}'
          echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        else
          echo "TICKET-DONE"
        fi
        exit 0 ;;
      # flail-then-good: every strike blocks, printing the FLAIL-REPEATED-ERROR
      # marker twice in its own output. If a real agy repeated the same error
      # on strike 1, the accumulated log has the marker twice after strike 1
      # alone — enough for the fake flail-detector's repeated-error signal.
      # Proves the scheduler skips strike 2 entirely: FAKE_STATE_DIR/builds
      # must show exactly 1 build attempt, not 2.
      flail-then-good)
        count_file="$FAKE_STATE_DIR/builds"
        n=$(cat "$count_file" 2>/dev/null || echo 0)
        echo $((n + 1)) > "$count_file"
        echo "FLAIL-REPEATED-ERROR: cannot resolve import"
        echo "FLAIL-REPEATED-ERROR: cannot resolve import"
        if [ "$output_format" = "stream-json" ]; then
          echo '{"type":"step_update","step":1,"action":"flail"}'
          echo '{"type":"result","status":"ERROR","exit_code":1}'
        else
          echo "TICKET-BLOCKED: stuck"
        fi
        exit 0 ;;
      # transient-then-good: strike 1 blocks with NO flail marker (a genuine
      # one-off), strike 2 behaves — proves a clean verdict does not cut the
      # normal retry short.
      transient-then-good)
        count_file="$FAKE_STATE_DIR/builds"
        n=$(cat "$count_file" 2>/dev/null || echo 0)
        echo $((n + 1)) > "$count_file"
        if [ "$n" -eq 0 ]; then
          if [ "$output_format" = "stream-json" ]; then
            echo '{"type":"step_update","step":1,"action":"transient-error"}'
            echo '{"type":"result","status":"ERROR","exit_code":1}'
          else
            echo "TICKET-BLOCKED: transient hiccup"
          fi
          exit 0
        fi
        echo "did the work" > "${tid:-out}.txt"
        if [ "$output_format" = "stream-json" ]; then
          echo '{"type":"step_update","step":1,"action":"transient-good"}'
          echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        else
          echo "TICKET-DONE"
        fi
        exit 0 ;;
      # rail-then-good: strike 1 violates the rail, strike 2 behaves —
      # proves the strike-2 worktree was reset (needs FAKE_STATE_DIR).
      rail-then-good)
        count_file="$FAKE_STATE_DIR/builds"
        n=$(cat "$count_file" 2>/dev/null || echo 0)
        echo $((n + 1)) > "$count_file"
        echo "did the work" > "${tid:-out}.txt"
        [ "$n" -eq 0 ] && echo edited > RAIL.txt
        if [ "$output_format" = "stream-json" ]; then
          echo '{"type":"step_update","step":1,"action":"rail-attempt"}'
          echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        else
          echo "TICKET-DONE"
        fi
        exit 0 ;;
      *)
        echo "did the work" > "${tid:-out}.txt"
        if [ "$output_format" = "stream-json" ]; then
          echo '{"type":"step_update","step":1,"action":"good"}'
          echo '{"type":"result","status":"SUCCESS","exit_code":0}'
        else
          echo "TICKET-DONE"
        fi
        exit 0 ;;
    esac ;;
esac

# Probe behavior: echo sentinel back.
if [ "$output_format" = "json" ]; then
  case "$prompt" in
    *INVALID_JSON*) echo "not a valid json output"; exit 0 ;;
    *) echo '{"status": "ok"}'; exit 0 ;;
  esac
fi
if [ "$output_format" = "stream-json" ]; then
  echo '{"type":"result","status":"SUCCESS","exit_code":0}'
  exit 0
fi
echo "$prompt" | grep -o 'PONG-[A-Za-z0-9]*' || echo "OK"
exit 0
