#!/bin/sh
# Fake adlc for offline tests. Implements just enough of `hollow-test`,
# `rails-guard`, and `model-router` — the subcommands lib/prosecute.mjs,
# lib/scheduler.mjs, and lib/plan.mjs call — for deterministic, fully-offline
# tests that don't depend on a globally-installed adlc CLI.
#
# model-router: canned, controllable assignments. FAKE_MODEL_ROUTER_MODE:
#   default   — echoes back --tickets' own ticket ids, each assigned
#               tier "frontier" (a value that could not be the ticket's own
#               pre-existing tier in these tests, so applying it is
#               observable) and records the invocation to FAKE_STATE_DIR.
#   p3        — same, plus a non-empty p3Findings array (advisory).
#   fail      — operational error, exit 1, unparseable stdout.
if [ "$1" = "model-router" ]; then
  shift
  ticketspath=""
  floor=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --tickets) ticketspath="$2"; shift 2 ;;
      --floor) floor="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  if [ -n "$FAKE_STATE_DIR" ]; then
    printf 'tickets=%s floor=%s\n' "$ticketspath" "$floor" >> "$FAKE_STATE_DIR/model-router-invocations"
  fi
  case "${FAKE_MODEL_ROUTER_MODE:-default}" in
    fail) echo "not json" ; exit 1 ;;
    *)
      ids=$(node -e "const t=require('$ticketspath'); console.log(t.tickets.map(x=>x.id).join('\n'))" 2>/dev/null)
      assignments=$(echo "$ids" | awk 'BEGIN{first=1} NF{if(!first) printf ","; printf "{\"id\":\"%s\",\"tier\":\"frontier\",\"mode\":\"direct\",\"railDensity\":1,\"float\":0,\"reason\":\"fake\"}", $0; first=0}')
      p3="[]"
      [ "${FAKE_MODEL_ROUTER_MODE:-}" = "p3" ] && p3='[{"id":"fake","message":"fake P3 finding"}]'
      echo "{\"assignments\":[$assignments],\"p3Findings\":$p3}"
      exit 0 ;;
  esac
fi
if [ "$1" = "rails-guard" ]; then
  shift
  base=""
  rails=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) base="$2"; shift 2 ;;
      --rails) rails="$rails
$2"; shift 2 ;;
      --json) shift ;;
      *) shift ;;
    esac
  done
  if [ -n "$FAKE_STATE_DIR" ]; then
    printf 'base=%s rails=%s\n' "$base" "$(echo "$rails" | tr '\n' ',')" >> "$FAKE_STATE_DIR/rails-guard-invocations"
  fi
  changed=$(git diff --name-only "$base" 2>/dev/null)
  violations=""
  echo "$rails" | while IFS= read -r glob; do
    [ -z "$glob" ] && continue
    prefix=$(echo "$glob" | sed 's/\*\*.*$//')
    echo "$changed" | while IFS= read -r f; do
      [ -z "$f" ] && continue
      case "$f" in
        "$glob") echo "$f" ;;
        "$prefix"*) [ -n "$prefix" ] && echo "$f" ;;
      esac
    done
  done > "${TMPDIR:-/tmp}/fake-adlc-violations.$$"
  violations=$(sort -u "${TMPDIR:-/tmp}/fake-adlc-violations.$$")
  rm -f "${TMPDIR:-/tmp}/fake-adlc-violations.$$"
  if [ -z "$violations" ]; then
    echo '{"tool":"rails-guard","passed":true,"violations":[]}'
    exit 0
  fi
  json_violations=$(echo "$violations" | awk 'BEGIN{first=1} {if(!first) printf ","; printf "{\"file\":\"%s\",\"type\":\"rail-edit\"}", $0; first=0}')
  echo "{\"tool\":\"rails-guard\",\"passed\":false,\"violations\":[$json_violations]}"
  exit 2
fi
if [ "$1" = "hollow-test" ]; then
  case "${FAKE_HOLLOW_TEST_MODE:-clean}" in
    survivors)
      echo '{"tool":"hollow-test","summary":{"total":2,"killed":1,"survived":1},"mutants":[{"file":"lib/x.mjs","line":1,"operator":"null-return","status":"survived","original":"return x;","mutated":"return null;"},{"file":"lib/x.mjs","line":2,"operator":"null-return","status":"killed","original":"return y;","mutated":"return null;"}]}'
      exit 2 ;;
    fail)
      echo "boom: simulated operational failure (dirty tree)" >&2
      exit 1 ;;
    *)
      echo '{"tool":"hollow-test","summary":{"total":2,"killed":2,"survived":0},"mutants":[]}'
      exit 0 ;;
  esac
fi
echo "fake-adlc: unimplemented subcommand '$1'" >&2
exit 1
