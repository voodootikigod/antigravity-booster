# Protects the ADLC rails-guard CI gate from being disarmed by a PR that
# also removes/edits its own workflow file. Self-protection requirement per
# ../adlc/docs/ci/rails-guard.yml. Review before enabling branch protection
# ("Require review from Code Owners") — a manual, repo-admin step this file
# alone does not perform.
.github/workflows/** @voodootikigod

# Native agy plugin execution and trust assets (spec .adlc/specs/native-plugin-
# installation.md, T-PLUGIN-01-CORE): anything that runs inside the user's agy
# session, ships prebuilt, or decides what a rail is.
/bin/** @voodootikigod
/hooks/** @voodootikigod
/hooks.json @voodootikigod
/mcp_config.json @voodootikigod
/commands/** @voodootikigod
/agents/** @voodootikigod
/plugin.json @voodootikigod
/dist/** @voodootikigod
/vendor/** @voodootikigod
/.adlc/** @voodootikigod

# ADLC bridge trust assets (T-PLUGIN-02-ADLC-BRIDGE): adlc resolution and the
# pinned vendored-adlc digests, the fail-closed enforcement gate and post-run
# integrity check, and the script that re-pins those digests.
/lib/adlc-bridge.mjs @voodootikigod
/lib/run-integrity.mjs @voodootikigod
/scripts/update-adlc-digests.mjs @voodootikigod
