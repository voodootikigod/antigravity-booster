{
  "name": "antigravity-booster",
  "version": "0.7.0",
  "description": "Orchestrates Google Antigravity for large parallel build-outs",
  "type": "module",
  "keywords": [
    "antigravity",
    "agy",
    "adlc",
    "llm",
    "agent",
    "orchestration",
    "ai-agents",
    "code-generation",
    "cli"
  ],
  "author": "Chris Williams <chris@voodootikigod.com> (https://github.com/voodootikigod)",
  "bin": {
    "agb": "bin/agb.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "sidecars/",
    ".agents/",

    "docs/",
    "templates/",
    "plugin.json",
    "!docs/fumadocs-plan.md",
    "!docs/github-rulesets/"
  ],
  "dependencies": {
    "@adlc/antigravity": "^1.7.0",
    "@adlc/cli": "1.11.1",
    "@adlc/core": "^1.11.1",
    "@adlc/tickets": "^1.11.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='skills/**' test/*.test.mjs",
    "coverage:check": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='skills/**' --test-coverage-lines=84 --test-coverage-branches=75 --test-coverage-functions=86 test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/voodootikigod/antigravity-booster.git"
  }
}
